<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <!-- Biblioteca de classe que precisa dos tipos de ASP.NET (middleware,
         IApplicationBuilder, health checks). FrameworkReference em vez de
         PackageReference: o runtime já traz esses assemblies, e referenciá-los
         como pacote duplicaria o que a aplicação hospedeira tem. -->
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Serilog.AspNetCore" Version="8.0.3" />
    <PackageReference Include="Serilog.Formatting.Compact" Version="3.0.0" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

</Project>
